{
  "name": "solo-tab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/db-setup.ts",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/db-migrate.ts",
    "admin:password": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/admin-password.ts",
    "audio:render": "f() { node scripts/tab-audio/render.mjs \"scripts/tab-audio/scores/$1.mjs\" \"/tmp/solo-tab-$1.wav\" && ffmpeg -v error -y -i \"/tmp/solo-tab-$1.wav\" -codec:a libmp3lame -b:a 160k \"public/audio/$1.mp3\" && rm \"/tmp/solo-tab-$1.wav\" && echo \"→ public/audio/$1.mp3\"; }; f",
    "postinstall": "node scripts/copy-alphatab-assets.mjs",
    "notation": "node scripts/tab-audio/to-alphatex.mjs"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
